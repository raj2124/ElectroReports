# ElectroReports app
ELECTROREPORTS_HOST=127.0.0.1
ELECTROREPORTS_PORT=3011

# Zoho Projects / OAuth
ZOHO_USE_MOCK=false
ZOHO_ENRICH_PROJECT_STAGE=true
ZOHO_BASE_URL=https://projectsapi.zoho.in/restapi
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_PORTAL_ID=your_portal_id_here
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ORG_USER_EMAIL_DOMAIN=elegrow.com
ZOHO_PROJECTS_ENDPOINT=
# New D03 project watch: minutes between Zoho polls (0 = off) and the project statuses that get a notice
ZOHO_POLL_MINUTES=15
ZOHO_NOTIFY_STATUSES=Planning,Active
# Optional API names of the task custom fields (found in the task payload otherwise)
ZOHO_TASK_FIELD_ESHA_TEST=
ZOHO_TASK_FIELD_PLANNED_QTY=
ZOHO_TASK_FIELD_CATEGORY=category

# OpenAI report-assist integration
OPENAI_API_KEY=
OPENAI_OBSERVATION_MODEL=gpt-6-luna
OPENAI_SANITY_MODEL=gpt-6-sol
# Optional: absolute PDF paths separated by ":" on macOS/Linux
OPENAI_REFERENCE_PDFS=

# Anthropic report narrative
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Gemini OCR integration
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ESCALATION_MODEL=gemini-4-argon
GEMINI_MAX_UPLOAD_BYTES=15728640
