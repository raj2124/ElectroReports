# ElectroReports app
ELECTROREPORTS_HOST=127.0.0.1
ELECTROREPORTS_PORT=3011

# Zoho Projects / OAuth
ZOHO_USE_MOCK=false
ZOHO_ENRICH_PROJECT_STAGE=true
ZOHO_BASE_URL=https://projectsapi.zoho.in/restapi
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_PORTAL_ID=your_portal_id_here
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=your_refresh_token_here
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ORG_USER_EMAIL_DOMAIN=elegrow.com
ZOHO_PROJECTS_ENDPOINT=
# Zoho People (read only: leave, holidays, employees). The same refresh token carries the People scopes
# (ZOHOPEOPLE.forms.ALL, employee.READ, leave.READ in the Self Client grant).
ZOHO_PEOPLE_BASE_URL=https://people.zoho.in
# Site Work Log (6G): the People form that gets one record per engineer, work date and test, written when a daily report is
# approved (write: forms.ALL scope). Fields are found by label (Engineer, Work Date, Project, Client, Test, Unit, Planned Qty,
# Completed Qty, Report Status, Returned Count, Data Gaps, On-time Submission, First-time Approved, Report ID, Record Key);
# override one by API name. Until the form exists entries wait and the admin Backfill / Retry sends them.
ZOHO_PEOPLE_WORKLOG_FORM=site_work_log
# ZOHO_PEOPLE_WORKLOG_FIELDS={"completedQty":"Completed_Qty1"}
# Schedule (6F): background refresh minutes (0 = off), manual refresh limit, hidden task statuses, working days
SCHEDULE_REFRESH_MINUTES=30
SCHEDULE_MANUAL_REFRESH_SECONDS=60
SCHEDULE_HIDDEN_STATUSES=Closed
SCHEDULE_WORKING_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
# New D03 project watch: minutes between Zoho polls (0 = off) and the project statuses that get a notice
ZOHO_POLL_MINUTES=15
ZOHO_NOTIFY_STATUSES=Planning,Active
# Optional API names of the task custom fields (found in the task payload otherwise)
ZOHO_TASK_FIELD_ESHA_TEST=
ZOHO_TASK_FIELD_PLANNED_QTY=
ZOHO_TASK_FIELD_CATEGORY=category

# OpenAI report-assist integration
OPENAI_API_KEY=
OPENAI_OBSERVATION_MODEL=gpt-6-luna
OPENAI_SANITY_MODEL=gpt-6-sol
# Optional: absolute PDF paths separated by ":" on macOS/Linux
OPENAI_REFERENCE_PDFS=

# Anthropic report narrative
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Gemini OCR integration
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_ESCALATION_MODEL=gemini-4-argon
GEMINI_MAX_UPLOAD_BYTES=15728640

# Sign-in (Session 6E): "Sign in with Zoho" (OpenID Connect) with a Server-based client from api-console.zoho.in
AUTH_MODE=zoho
AUTH_ZOHO_CLIENT_ID=
AUTH_ZOHO_CLIENT_SECRET=
AUTH_ZOHO_REDIRECT_URI=http://127.0.0.1:3011/auth/callback
AUTH_ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
# AUTH_ZOHO_SCOPE=openid email profile   (fallback: AaaServer.profile.READ)
AUTH_ALLOWED_DOMAIN=elegrow.com
AUTH_SESSION_IDLE_HOURS=12
# generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=
AUTH_SEED_ADMINS=shivam@elegrow.com
# Development and tests only, never in production: AUTH_MODE=dev with AUTH_DEV_USERS=email:role+role:Name:Designation,...

# Microsoft Graph (Session 6H): Outlook calendar sync and the read-only SharePoint knowledge base. See docs/graph-setup.md.
# GRAPH_USE_MOCK=true runs both on an in-memory Graph (no tenant needed). Never put a secret or a key in this file's values
# in git: .env is ignored; the certificate's private key lives OUTSIDE the repo.
GRAPH_USE_MOCK=true
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# certificate (recommended): the private key file and the SHA-256 thumbprint of the uploaded .crt
GRAPH_CERT_PATH=
GRAPH_CERT_THUMBPRINT_SHA256=
# or, instead of a certificate:
# GRAPH_CLIENT_SECRET=
# where engineers open the app: the calendar events link to <APP_BASE_URL>/?project=<id> (leave empty until it is hosted)
APP_BASE_URL=
GRAPH_CALENDAR_TIMEZONE=India Standard Time
# SharePoint sources, read only (Sites.Selected with "read" per site). folders: only index these (library/path); scope: client = project
# documents visible per project, general = visible to everyone. Client sites: project folders at the root of Shared Documents named
# NNN-D03_TS-YY-CLIENT or NNN_MM_YY_TS_CLIENT_ESHA; only their Submitted, Reference and Input folders are indexed (Working is skipped).
GRAPH_KB_SITES=[{"name":"ETPL_OP_26_27","url":"https://eletechnology.sharepoint.com/sites/ETPL_OP_26_27","folders":[],"scope":"client"},{"name":"FY23-24","url":"https://eletechnology.sharepoint.com/sites/FY23-24","folders":[],"scope":"client"},{"name":"FY23-24-StandardsGuideline","url":"https://eletechnology.sharepoint.com/sites/FY23-24-StandardsGuideline","folders":["Shared Documents/ETPL Knowledge Hub/02 Technical Knowledge"],"scope":"general"}]
GRAPH_KB_REFRESH_MINUTES=60
GRAPH_KB_MAX_MB=40
# GRAPH_KB_DB=   (default: knowledge.db next to the report database)
